# Copy to .env for local overrides. Never commit .env.
APP_ENVIRONMENT=development
APP_DATABASE_URL=sqlite:///./data/app.db

# Optional: enable AI interpretation of meal descriptions.
# APP_OPENAI_API_KEY=your-openai-api-key
# APP_AI_MODEL=gpt-6-luna
# APP_AI_TIMEOUT_SECONDS=10.0

# USDA FoodData Central key; DEMO_KEY is rate-limited to 30 requests/hour.
# APP_USDA_API_KEY=your-free-data-gov-key
